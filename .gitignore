# ============ Nox .gitignore ============
# Секреты и ключи (НИКОГДА не коммитить)
jarvis-voice/bea_key.txt
jarvis-voice/bls_key.txt
jarvis-voice/apimira_key.txt
jarvis-voice/nox_scenarios.json
**/*_key.txt
**/*.key
**/*.env
**/*secret*
# app.db лежит в %APPDATA%\com.priler.jarvis, но на всякий случай:
**/app.db

# Python
jarvis-voice/.venv/
**/__pycache__/
*.pyc

# Runtime-состояние и флаги (генерируются на ходу)
jarvis-voice/*_state.json
jarvis-voice/*_mon_on.txt
jarvis-voice/news_monitor_on.txt
jarvis-voice/tts_speed.txt
jarvis-voice/*_filter.json
jarvis-voice/marker.txt

# Профили браузеров (содержат логин-сессии/cookies — приватность!)
jarvis-voice/yandex_jarvis/
jarvis-voice/browser_profile/
jarvis-voice/mind_profile/
jarvis-voice/pw-browsers/

# Логи и временные артефакты
**/*.log
jarvis-voice/*.wav
jarvis-voice/compare/
jarvis-voice/ffmpeg-shared/

# Rust
jarvis-lab/target/

# Frontend
jarvis-lab/frontend/node_modules/
jarvis-lab/frontend/dist/

# Крупные модели (качаются отдельно — см. README)
jarvis-lab/resources/models/
jarvis-lab/resources/vosk/
jarvis-lab/target/release/resources/models/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Telegram: сессия = полный доступ к аккаунту, конфиг содержит api_hash
**/tg_session.session*
**/*.session
**/*.session-journal
**/tg_config.json

# Личные данные и рабочие журналы — НЕ публиковать (репозиторий публичный)
jarvis-voice/*.jsonl
jarvis-voice/nox_watchers.json
jarvis-voice/nox_notes.json
jarvis-voice/nox_calendar.json
jarvis-voice/nox_agenda*.json
jarvis-voice/cscalp_layout.json
jarvis-voice/cscalp_keys.json
jarvis-voice/astra_chats/
jarvis-voice/_gmail_url.txt
jarvis-voice/sys_monitor.json
jarvis-voice/tts_engine.txt
jarvis-voice/tts_silero_speaker.txt
jarvis-voice/xtts_ready.flag
# Бэкапы правок
**/*.bak
**/*.bak_*
